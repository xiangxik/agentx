NODE_ENV=development

VITE_API_BASE_URL=http://localhost:8080
VITE_CHATBOT_PUBLIC_BASE_URL=http://localhost:4173

APP_NAME=agentx-chatbot
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

DB_HOST=localhost
DB_PORT=5432
DB_NAME=agentx
DB_USER=agentx
DB_PASSWORD=agentx

JWT_ISSUER=agentx
JWT_SECRET=change-me-to-a-long-secret
JWT_EXPIRATION_MINUTES=120

MODEL_PROVIDER_DEFAULT_BASE_URL=https://api.openai.com/v1
MODEL_PROVIDER_DEFAULT_MODEL=gpt-4o-mini
MODEL_PROVIDER_DEFAULT_EMBEDDING_MODEL=text-embedding-3-small
MODEL_PROVIDER_DEFAULT_API_KEY=change-me

FILES_ROOT=./storage/files
MAX_UPLOAD_SIZE_MB=10
WEB_CRAWL_MIN_INTERVAL_MINUTES=60
CONVERSATION_RETENTION_DAYS=365
CHAT_STREAMING_ENABLED=false
CONTENT_MODERATION_ENABLED=false
CUSTOM_CHAT_DOMAIN_ENABLED=false
